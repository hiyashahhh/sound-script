# Required: free Gemini API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: override models (defaults shown). Both have a free tier.
# GEMINI_MODEL=gemini-3.5-flash-lite
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768

# Optional: Pinecone. Leave blank to use the local FAISS index (shown in /api/health).
# If you use Pinecone, create the index with the same dimension as EMBED_DIM (768).
PINECONE_API_KEY=
PINECONE_INDEX=soundscript

# Optional: LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
